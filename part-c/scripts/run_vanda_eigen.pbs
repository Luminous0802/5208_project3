#!/bin/bash -l
#PBS -N graph_eig_mpich
#PBS -q auto_free
#PBS -l select=1:ncpus=8:mpiprocs=4:mem=16gb
#PBS -l walltime=02:00:00
#PBS -j oe

# MPI+OpenMP on exactly one PBS-allocated node, using a fresh MPICH build.
set -euo pipefail
export LC_ALL=C
: "${PBS_JOBID:?Submit through PBS}"
: "${PBS_O_WORKDIR:?Missing submission directory}"
: "${PBS_NODEFILE:?Missing PBS allocation}"
cd "$PBS_O_WORKDIR"
test -f scripts/compare_eigen.py
job=${PBS_JOBID%%.*}
result_dir="$PWD/results/Vanda_eigen_${job}"
if [[ -e "$result_dir" ]]; then
    echo "Choose a fresh output: $result_dir" >&2
    exit 1
fi
mkdir -p "$result_dir"
exec > >(tee "$result_dir/workflow.log") 2>&1
trap 'status=$?; printf "FAILED: exit=%s line=%s command=%s\n" "$status" "$LINENO" "$BASH_COMMAND" >&2; exit "$status"' ERR
printf 'START mode=MPI+OpenMP implementation=MPICH job=%s node=%s\n' "$PBS_JOBID" "$(hostname)"
# Unload the previously used OpenMPI module if present. All MPI paths below
# come explicitly from the MPICH module supplied by Vanda.
module unload openmpi/gcc/64/4.1.8 2>/dev/null || true
module load gcc11/11.3.0
module load mpich/ge/gcc/64/4.1.1
module load python39
module list
: "${MPI_HOME:?MPICH module did not provide MPI_HOME}"
mpicxx="$MPI_HOME/bin/mpicxx"
mpi_exec="$MPI_HOME/bin/mpiexec.hydra"
test -x "$mpicxx"
test -x "$mpi_exec"
"$mpicxx" -show > "$result_dir/mpi_compiler_command.txt"
"$mpi_exec" -info > "$result_dir/mpi_launcher_info.txt"
g++ --version
python3 --version
qstat -f "$PBS_JOBID" > "$result_dir/pbs_job.txt"
cp "$PBS_NODEFILE" "$result_dir/pbs_nodefile.txt"
lscpu > "$result_dir/cpu_topology.txt"
# The local fork launcher is restricted to this single allocated host. Verify
# actual allocation before building or launching any MPI program.
python3 - "$PBS_NODEFILE" "$result_dir/pbs_job.txt" <<'PY'
from pathlib import Path
import re,sys
hosts=set(Path(sys.argv[1]).read_text().split())
job=Path(sys.argv[2]).read_text()
match=re.search(r'^\s*Resource_List\.ncpus\s*=\s*(\d+)',job,re.M)
if len(hosts)!=1 or match is None or int(match.group(1))<8:
    raise RuntimeError('MPICH local-fork mode requires one PBS node with at least 8 allocated CPUs')
PY
export OMP_NUM_THREADS=2 OMP_DYNAMIC=FALSE OMP_PROC_BIND=close OMP_PLACES=cores
export OPENBLAS_NUM_THREADS=1
# This single-node job uses a software OFI provider rather than requiring RDMA
# device access. An explicit FI_PROVIDER supplied at qsub time takes priority.
export FI_PROVIDER="${FI_PROVIDER:-sockets}"
printf 'OFI_PROVIDER_REQUEST=%s\n' "$FI_PROVIDER"
python3 - "$result_dir/communication_environment.json" <<'PYENV'
import json,os,sys
keys=['FI_PROVIDER','FI_PROVIDER_PATH','FI_LOG_LEVEL','MPIR_CVAR_CH4_NETMOD','MPIR_CVAR_CH4_SHM_ENABLE']
with open(sys.argv[1],'w') as f:
    json.dump({key:os.environ.get(key) for key in keys},f,indent=2)
    f.write('\n')
PYENV
unset CPU_PREFIX PAGERANK_DUMP HYDRA_TOPO_DEBUG HYDRA_BINDING HYDRA_MAPPING
export MPIEXEC="$mpi_exec"
# Explicit local placement keeps all ranks inside the single allocated node.
# This still launches real MPI processes and uses MPI collectives.
export MPIEXEC_ARGS='-rmk user -launcher fork -hosts localhost -bind-to core:2'
export EIGEN_EXPECTED_MPI=MPICH
bin_dir="$PWD/work/eigen_mpich_build_${job}/bin"
make BIN="$bin_dir" CXX=g++ MPICXX="$mpicxx" -j 4 \
    "$bin_dir/make_graph" "$bin_dir/power_symmetric" "$bin_dir/lanczos" \
    "$bin_dir/power_symmetric_mpi" "$bin_dir/lanczos_mpi"
"$mpicxx" -O2 -std=c++17 -Wall -Wextra -Wpedantic -fopenmp -DLANCZOS_MPI \
    tests/mpi_eigen_probe.cpp -o "$bin_dir/mpi_eigen_probe"
python3 -u scripts/probe_eigen_mpi.py --binary "$bin_dir/mpi_eigen_probe" \
    --out "$result_dir/mpi_probe"
python3 -u scripts/validate_eigen_pair.py --site Vanda \
    --bin-dir "$bin_dir" --out "$result_dir/validation"
mpi_launch=$(python3 - "$mpi_exec" <<'PY'
import shlex,sys
print(shlex.join([sys.argv[1],'-rmk','user','-launcher','fork','-hosts','localhost','-bind-to','core:2','-n','4']))
PY
)
hardware_tag=$(python3 - "$result_dir/cpu_topology.txt" <<'PY'
from pathlib import Path
import platform,sys
lines=Path(sys.argv[1]).read_text().splitlines()
model=next((line.split(':',1)[1].strip() for line in lines if line.startswith('Model name:')),platform.machine())
print(platform.node()+'_'+model)
PY
)
python3 -u scripts/compare_eigen.py --site Vanda \
    --hardware-tag "$hardware_tag" --bin-dir "$bin_dir" \
    --launcher-prefix "$mpi_launch" --mpi-ranks 4 --omp-threads 2 \
    --mpi-implementation MPICH-4.1.1 --out "$result_dir/comparison" \
    --N "${EIGEN_N:-100000}" --repeats "${EIGEN_REPEATS:-5}" --no-plot
printf 'SUCCESS: mode=MPI+OpenMP ranks=4 threads=2 implementation=MPICH results=%s\n' "$result_dir"
